# Existing Spring/NestJS PostgreSQL database. Use a PostgreSQL URI, not jdbc:.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/employee_attendance?sslmode=disable
# Set to the EXACT raw JWT_SECRET used by Spring (not base64-encoded).
# No development fallback: the application refuses a secret shorter than 32 bytes.
JWT_SECRET=
# Spring stays on 8080; Go Attendance runs on 8081.
HTTP_ADDR=:8081
CORS_ALLOWED_ORIGIN=http://localhost:5173
